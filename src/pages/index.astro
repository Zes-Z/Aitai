---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContentFlow from '../components/ContentFlow.astro';
import Harbor from '../components/Harbor.astro';
import { siteConfig } from '../../SiteConfig';
import type { Lang } from '../types';

const lang: Lang = 'zh';
---

<BaseLayout lang={lang} page="home" description={siteConfig.site.description[lang]}>
  <Hero lang={lang} />
  <ContentFlow lang={lang} />
  <Harbor lang={lang} />
</BaseLayout>
