---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../../SiteConfig';
import { t } from '../../../i18n';
import { homePath } from '../../../utils/paths';
import { LANGS, type Lang } from '../../../types';

export function getStaticPaths() {
  return siteConfig.site.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const langIndex = LANGS.indexOf(lang);
const allAlbum = await getCollection('album');
const photos = allAlbum
  .filter((entry) => !entry.data.draft)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title[langIndex] ?? entry.data.title[0],
    place: (entry.data.place ?? [entry.data.location, entry.data.location, entry.data.location])[langIndex] ?? entry.data.location,
    date: entry.data.date,
    ratio: entry.data.ratio,
    palette: entry.data.palette ?? ['#0b1026', '#22306b', '#8fb3ff'],
  }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout lang={lang} page="detail" title={t('nav.album', lang)} description={t('album.note', lang)}>
  <section class="detail-page">
    <div class="detail-inner">
      <a class="detail-back" href={homePath(lang) + '#content'}>← {t('nav.home', lang)}</a>

      <header class="index-head">
        <div>
          <h1 class="index-title">{t('nav.album', lang)}</h1>
          <p class="section-intro">{t('album.note', lang)}</p>
        </div>
        <span class="mono faint">{String(photos.length).padStart(2, '0')}</span>
      </header>

      <div class="album-grid">
        {photos.map((photo) => (
          <article
            class="album-item"
            id={'photo-' + photo.id}
            data-ratio={photo.ratio}
            data-reveal
            style={'--p1:' + photo.palette[0] + ';--p2:' + photo.palette[1] + ';--p3:' + photo.palette[2]}
          >
            <div class="album-art"></div>
            <div class="album-caption">
              <div class="meta">{photo.date} · {photo.place}</div>
              <div class="name">{photo.title}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
