---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../../i18n';
import { withBase } from '../../../utils/paths';
import type { Lang } from '../../../types';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  return posts.map((entry) => {
    const [slug, lang] = entry.id.split('/');
    return { params: { lang, slug } };
  });
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const all = (await getCollection('post'))
  .filter((entry) => entry.id.endsWith('/' + lang))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const index = all.findIndex((entry) => entry.id === slug + '/' + lang);
const entry = all[index] ?? all[0];
const next = all[(index + 1) % all.length];
const { Content } = await render(entry);
const palette = '--p1:' + entry.data.palette[0] + ';--p2:' + entry.data.palette[1] + ';--p3:' + entry.data.palette[2];
---

<BaseLayout lang={lang} page="detail" title={entry.data.title} description={entry.data.excerpt}>
  <article class="detail-page">
    <div class="detail-inner">
      <a class="detail-back" href={withBase('/' + lang + '/thoughts/')} data-transition="veil">← {t('nav.thoughts', lang)}</a>

      <div class="detail-kicker">
        <span>{entry.data.date}</span>
        <span>{entry.data.reading} min read</span>
        <span>{t('act.realms', lang)}</span>
      </div>
      <h1 class="detail-title">{entry.data.title}</h1>
      <p class="detail-summary">{entry.data.excerpt}</p>

      <div class="detail-hero" style={palette}>
        <span class="detail-mark">会</span>
      </div>

      <div class="detail-body">
        <Content />
      </div>

      <div class="detail-next">
        <span>{t('aria.next', lang)}</span>
        <a href={withBase('/' + lang + '/thoughts/' + next.id.split('/')[0] + '/')} data-transition="constellate">
          {next.data.title} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
