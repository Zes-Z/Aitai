---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../../SiteConfig';
import { t } from '../../../i18n';
import { homePath, withBase } from '../../../utils/paths';
import type { Lang } from '../../../types';

export function getStaticPaths() {
  return siteConfig.site.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const allPosts = await getCollection('post');
const thoughts = allPosts
  .filter((entry) => entry.id.endsWith('/' + lang))
  .map((entry) => ({ slug: entry.id.split('/')[0], ...entry.data }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout lang={lang} page="detail" title={t('nav.thoughts', lang)} description={t('thoughts.note', lang)}>
  <section class="detail-page">
    <div class="detail-inner">
      <a class="detail-back" href={homePath(lang) + '#content'}>← {t('nav.home', lang)}</a>

      <header class="index-head">
        <div>
          <h1 class="index-title">{t('nav.thoughts', lang)}</h1>
          <p class="section-intro">{t('thoughts.note', lang)}</p>
        </div>
        <span class="mono faint">{String(thoughts.length).padStart(2, '0')}</span>
      </header>

      <div class="index-list">
        {thoughts.map((thought) => (
          <a class="index-row" href={withBase('/' + lang + '/thoughts/' + thought.slug + '/')} data-transition="constellate">
            <span class="year">{thought.date}</span>
            <span class="name">{thought.title}</span>
            <span class="meta">{thought.reading} min</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
