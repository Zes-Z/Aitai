---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../SiteConfig';
import { renderMarkdown } from '../../utils/markdown';
import type { Lang } from '../../types';

export function getStaticPaths() {
  return siteConfig.site.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const page = await getEntry('pages', lang);
const html = (await renderMarkdown(page?.body ?? '')).html;
---

<BaseLayout lang={lang} page="welcome-site" title={page?.data.title ?? 'Welcome to this site!'}>
  <article class="welcome-site-page">
    <h1 class="welcome-site-title">{page?.data.title ?? 'Welcome to this site!'}</h1>
    <div class="prose welcome-site-body" set:html={html} />
  </article>
</BaseLayout>

<style is:global>
  .welcome-site-page {
    width: min(100% - 2 * var(--gutter), 780px);
    margin-inline: auto;
    padding: clamp(7rem, 16vh, 12rem) 0 clamp(5rem, 12vh, 9rem);
    text-align: center;
  }

  .welcome-site-title {
    margin: 0 0 1.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .welcome-site-body {
    text-align: left;
    font-size: 1.02rem;
    line-height: 1.9;
    color: var(--text);
    overflow-wrap: break-word;
  }

  .welcome-site-body > :first-child { margin-top: 0; }
  .welcome-site-body > :last-child { margin-bottom: 0; }
  .welcome-site-body p { margin: 0.9em 0; }
  .welcome-site-body strong { color: var(--text); font-weight: 600; }
  .welcome-site-body hr {
    margin: 2.2em 0;
    border: 0;
    border-top: 1px solid var(--border);
  }
  .welcome-site-body ul,
  .welcome-site-body ol { margin: 0.9em 0; padding-left: 1.5em; }
  .welcome-site-body ul { list-style: disc; }
  .welcome-site-body ol { list-style: decimal; }
  .welcome-site-body li { margin: 0.35em 0; }
  .welcome-site-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .welcome-site-body .directive {
    margin: 1.2em 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: color-mix(in srgb, var(--surface) 75%, transparent);
  }
  .welcome-site-body .directive-title {
    margin-bottom: 0.35em;
    font-weight: 600;
    color: var(--text);
  }
  .welcome-site-body .directive p { margin: 0.3em 0 0; color: var(--muted); }
</style>