---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../../SiteConfig';
import { t } from '../../../i18n';
import { homePath, withBase } from '../../../utils/paths';
import type { Lang } from '../../../types';

export function getStaticPaths() {
  return siteConfig.site.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const all = await getCollection('project');
const projects = all
  .filter((entry) => entry.id.endsWith('/' + lang))
  .map((entry) => ({ slug: entry.id.split('/')[0], ...entry.data }))
  .sort((a, b) => a.index.localeCompare(b.index));
---

<BaseLayout lang={lang} page="detail" title={t('nav.projects', lang)}>
  <section class="detail-page">
    <div class="detail-inner">
      <a class="detail-back" href={homePath(lang) + '#realms'}>← {t('act.realms', lang)}</a>

      <header class="index-head">
        <h1 class="index-title">{t('nav.projects', lang)}</h1>
        <span class="mono faint">{String(projects.length).padStart(2, '0')}</span>
      </header>

      <div class="index-list">
        {projects.map((project) => (
          <a class="index-row" href={withBase('/' + lang + '/projects/' + project.slug + '/')} data-transition="tide">
            <span class="year">{project.year}</span>
            <span class="name">{project.title}</span>
            <span class="meta">{project.role}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
