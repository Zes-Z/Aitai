---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import WorldCanvas from '../components/WorldCanvas.astro';
import GalaxyBackground from '../components/backgrounds/Galaxy/GalaxyBackground';
import AvatarDock from '../components/AvatarDock.astro';
import ThemeOrb from '../components/ThemeOrb.astro';
import ThemeTransition from '../components/ThemeTransition.astro';
import PageTransition from '../components/PageTransition.astro';
import Cursor from '../components/Cursor.astro';
import Toast from '../components/Toast.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import { siteConfig } from '../../SiteConfig';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  page?: string;
}

const { lang, title, description, page = 'page' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme={siteConfig.theme.default} transition:animate="none">
  <head>
    <BaseHead lang={lang} title={title} description={description} />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">Skip to content</a>

    <GalaxyBackground client:only="react" />
    <WorldCanvas />
    <AvatarDock lang={lang} />
    <ThemeOrb lang={lang} path={Astro.url.pathname} />

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>
    <ThemeTransition />
    <PageTransition />
    <Cursor />
    <Toast />
    <ScrollProgress />
    <div class="grain" aria-hidden="true"></div>

    <script>
      import { initShell } from '../scripts/shell';
      import { initPageTransitions } from '../scripts/page-transitions';
      initShell();
      initPageTransitions();
    </script>
  </body>
</html>
