---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import WorldCanvas from '../components/WorldCanvas.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import AvatarDock from '../components/AvatarDock.astro';
import MobileDock from '../components/MobileDock.astro';
import ThemeTransition from '../components/ThemeTransition.astro';
import Cursor from '../components/Cursor.astro';
import Toast from '../components/Toast.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  page?: string;
}

const { lang, title, description, page = 'page' } = Astro.props;
const isHome = page === 'home';
---

<!doctype html>
<html lang={lang} data-theme="star">
  <head>
    <BaseHead lang={lang} title={title} description={description} />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">Skip to content</a>

    <WorldCanvas />
    <Header lang={lang} />
    <MobileMenu lang={lang} />
    <AvatarDock lang={lang} home={isHome} />

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <MobileDock lang={lang} />
    <ThemeTransition />
    <Cursor />
    <Toast />
    <ScrollProgress />
    <div class="grain" aria-hidden="true"></div>

    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>
