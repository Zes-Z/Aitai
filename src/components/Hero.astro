---
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from '../../SiteConfig';
import { t } from '../i18n';
import { withBase } from '../utils/paths';
import type { Lang } from '../types';
import Lanyard from './lanyard/Lanyard';
import { makeLanyardFaces } from './lanyard/faces';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tagline = siteConfig.site.tagline[lang];
const mottoLines = siteConfig.hero.motto.map((line) => line[lang]);
const cv = siteConfig.identity.socials.find((social) => social.icon === 'cv');
const resume = cv?.href ? withBase(cv.href) : undefined;
const avatar = withBase(siteConfig.identity.avatar);
const email = siteConfig.identity.email;
const github = siteConfig.identity.socials.find((s) => s.icon === 'github');
const status = siteConfig.identity.status[lang];
const location = siteConfig.identity.location[lang];
const timezone = siteConfig.identity.timezone;

const posts = await getCollection('post');
const projects = await getCollection('project');
const album = await getCollection('album');
const countFor = (entries: Array<{ id: string }>) => entries.filter((entry) => entry.id.endsWith('/' + lang)).length;
const avatarExtension = siteConfig.identity.avatar.split('.').pop() || 'jpg';
const avatarMime = avatarExtension === 'svg' ? 'image/svg+xml' : avatarExtension === 'png' ? 'image/png' : 'image/jpeg';
const avatarBytes = readFileSync(join(process.cwd(), 'public', siteConfig.identity.avatar.replace(/^\//, '')));
const avatarData = 'data:' + avatarMime + ';base64,' + avatarBytes.toString('base64');
const faces = makeLanyardFaces({
  lang,
  name: siteConfig.identity.name,
  nameJa: siteConfig.identity.nameJa,
  available: t('hero.available', lang),
  status,
  location,
  quote: siteConfig.hero.motto[1][lang],
  avatar: avatarData,
  counts: {
    languages: siteConfig.site.langs.length,
    notes: countFor(posts),
    photos: album.filter((entry) => !entry.data.draft).length,
    projects: countFor(projects),
  },
});
---

<section id="tide" class="hero" data-section aria-labelledby="hero-title">
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-eyebrow eyebrow">AITAI / 会いたい</div>
      <h1 id="hero-title" class="hero-title">
        <span class="latin">{siteConfig.identity.name}</span>
      </h1>
      <p class="hero-tagline">{tagline}</p>

      <div class="hero-motto" data-typewriter data-lines={JSON.stringify(mottoLines)}>
        <span class="sr-only">{mottoLines[0]}</span>
        <span aria-hidden="true" data-typewriter-text></span>
        <span class="caret" aria-hidden="true"></span>
      </div>

      <div class="hero-actions">
        {resume && <a class="btn btn-primary" href={resume} download>
          {t('hero.downloadCv', lang)}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14" /></svg>
        </a>}
        <a class="btn" href={'mailto:' + email}>
          {t('hero.email', lang)}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 6h16v12H4z" /><path d="M4 7l8 6 8-6" /></svg>
        </a>
        {github && (
          <a class="btn" href={github.href} target="_blank" rel="noreferrer">
            {t('hero.github', lang)}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          </a>
        )}
      </div>

      <div class="hero-meta">
        <span><i aria-hidden="true"></i>{status}</span>
        <span>{location}</span>
        <span>{timezone.replace('_', ' ')}</span>
      </div>
    </div>

    <aside class="hero-lanyard" aria-label={siteConfig.identity.name + ' · ' + t('hero.available', lang)}>
      <div class="hero-avatar" data-avatar-hero aria-hidden="true">
        <img src={avatar} alt="" width="120" height="120" />
      </div>

      <div class="lanyard-stage">
        <Lanyard
          client:only="react"
          frontImage={faces.front}
          backImage={faces.back}
          imageFit="cover"
          cardColor="#0b0b12"
          orientation="portrait"
          finish="matte"
          cornerRadius={0.22}
          size={0.76}
          anchor="center"
          strapLength={0.5}
          strapColor="#1a1a26"
          strapWidth={0.72}
          metal="silver"
          gravity={0.9}
          damping={0.55}
          elasticity={0.5}
          breeze={0.35}
          interactive
          intro
        />
      </div>

      <div class="lanyard-caption">
        <span class="lanyard-clock">
          <b data-clock data-tz={timezone}>--:--</b>
          <em data-date data-tz={timezone} data-lang={lang}></em>
        </span>
        <span>{location}</span>
        <span class="lanyard-flip">{t('lanyard.flip', lang)}</span>
      </div>
    </aside>
  </div>

  <a class="hero-scroll" href="#drift">
    <span class="scroll-line" aria-hidden="true"></span>
    {siteConfig.theme.order.map((theme) => (
      <span class="hero-scroll-label" data-scroll-theme={theme}>{t(`hero.scroll.${theme}`, lang)}</span>
    ))}
  </a>
</section>
