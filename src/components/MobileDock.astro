---
import { siteConfig } from '../../SiteConfig';
import { l10n } from '../i18n';
import { homePath } from '../utils/paths';
import type { Lang } from '../types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const home = homePath(lang);
const sections = siteConfig.nav.sections;
const icons = ['home', 'grid', 'image', 'lines'] as const;
---

<nav class="mobile-dock" aria-label="Sections">
  {sections.map((section, index) => (
    <a class="dock-link" href={`${home}#${section.id}`} data-nav-link>
      {icons[index] === 'home' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z" />
        </svg>
      )}
      {icons[index] === 'grid' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="4" y="4" width="7" height="7" rx="1" /><rect x="13" y="4" width="7" height="7" rx="1" />
          <rect x="4" y="13" width="7" height="7" rx="1" /><rect x="13" y="13" width="7" height="7" rx="1" />
        </svg>
      )}
      {icons[index] === 'image' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.5" />
          <path d="M4 17l5-4 4 3 3-2 4 3" />
        </svg>
      )}
      {icons[index] === 'lines' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M4 7h16M4 12h10M4 17h13" />
        </svg>
      )}
      <span>{l10n(section.label, lang)}</span>
    </a>
  ))}
</nav>
