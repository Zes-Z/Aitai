---
import { t } from '../i18n';
import { withBase } from '../utils/paths';
import { LANGS, type Lang } from '../types';
import OrbArt from './OrbArt.astro';
import '../styles/theme-orb.css';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const nextLang = LANGS[(LANGS.indexOf(lang) + 1) % LANGS.length];

const langHref = (l: Lang) => {
  const re = new RegExp('/' + lang + '(?=/|$)');
  return re.test(path) ? path.replace(re, '/' + l) : withBase('/' + l + '/');
};
---

<div class="theme-orb" data-theme-orb>
  <button
    type="button"
    class="orb-button"
    data-theme-trigger
    data-language-href={langHref(nextLang)}
    data-transition="language"
    data-label={t('orb.label', lang)}
    data-theme-name-star={t('theme.star', lang)}
    data-theme-name-sea={t('theme.sea', lang)}
    data-theme-name-dawn={t('theme.dawn', lang)}
    aria-label={t('orb.label', lang)}
    aria-keyshortcuts="Enter Space ArrowDown"
  >
    <OrbArt />
    <svg class="orb-hold" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" pathLength="1" />
    </svg>
  </button>

  <span class="orb-hint" aria-hidden="true">{t('orb.hint', lang)}</span>
  <span class="sr-only" data-theme-status role="status"></span>
</div>

<script>
  import { initTheme } from '../scripts/theme';
  import { initOrbArt } from '../scripts/orb-art';
  const run = () => { initTheme(); initOrbArt(); };
  run();
  document.addEventListener('astro:page-load', run);
</script>
