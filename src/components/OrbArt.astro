---
import SeaCrystalOrb from './orb/SeaCrystalOrb';
// Dawn: CSS sun. Sea: ReactBits Crystalized Ball. Star: WebGL black hole.
---
<span class="orb-scene orb-scene--dawn" aria-hidden="true">
  <span class="orb-sun"></span>
</span>
<span class="orb-scene orb-scene--crystal" aria-hidden="true">
  <SeaCrystalOrb client:only="react" />
</span>
<canvas
  class="orb-scene orb-scene--dynamic"
  data-orb-canvas
  width="256"
  height="256"
  aria-hidden="true"
  transition:persist="orb-art"
></canvas>
<span class="orb-glass" aria-hidden="true"></span>
