---
// Dawn keeps the original CSS sun; sea and star use the WebGL sphere.
---
<span class="orb-scene orb-scene--dawn" aria-hidden="true">
  <span class="orb-sun"></span>
</span>
<canvas
  class="orb-scene orb-scene--dynamic"
  data-orb-canvas
  width="256"
  height="256"
  aria-hidden="true"
  transition:persist="orb-art"
></canvas>
<span class="orb-glass" aria-hidden="true"></span>
