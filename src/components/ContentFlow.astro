<script>
  function copyTextFallback(text: string, done: () => void) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); done(); } catch { /* ignore */ }
    ta.remove();
  }

  document.addEventListener('click', (event) => {
    const btn = event.target instanceof Element ? event.target.closest('[data-copy-code]') : null;
    if (!(btn instanceof HTMLButtonElement)) return;
    const code = btn.closest('.code-block')?.querySelector('pre code');
    if (!code) return;
    const text = code.textContent ?? '';
    const done = () => {
      btn.textContent = '✓';
      window.setTimeout(() => { btn.textContent = '⧉'; }, 1400);
    };
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(() => copyTextFallback(text, done));
    } else {
      copyTextFallback(text, done);
    }
  });
</script>
