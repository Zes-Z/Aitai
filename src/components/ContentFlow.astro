---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { posix } from 'node:path';
import { t } from '../i18n';
import type { Lang } from '../types';
import { getAlbumEntries, getAlbumHomeItems, resolvePortfolioAsset, type PortfolioCard } from '../utils/album';
import { renderMarkdown } from '../utils/markdown';
import { coverAccent } from '../utils/cover-color';
import { withBase } from '../utils/paths';
import ChromaGrid from './chroma/ChromaGrid';
import '../styles/content-flow.css';
import '../styles/content-depth.css';
import '../styles/content-sheet.css';
import 'katex/dist/katex.min.css';

interface Props { lang: Lang }
const { lang } = Astro.props;

const postImageModules = import.meta.glob<ImageMetadata>(
  '/src/content/post/**/*.{png,jpg,jpeg,PNG,JPG,JPEG,webp,gif,svg,avif}',
  { eager: true, import: 'default' }
);
const postImageIndex = new Map(
  Object.entries(postImageModules).map(([path, meta]) => [path.toLowerCase(), meta])
);
const postFilesBySlug = (slug: string) =>
  Object.keys(postImageModules)
    .filter((path) => path.startsWith('/src/content/post/' + slug + '/'))
    .sort();

const albumImageModules = import.meta.glob<ImageMetadata>(
  '/src/content/album/**/*.{png,jpg,jpeg,PNG,JPG,JPEG,webp,avif,gif}',
  { eager: true, import: 'default' }
);
const projectImageModules = import.meta.glob<ImageMetadata>(
  '/src/content/projects/**/*.{png,jpg,jpeg,PNG,JPG,JPEG,webp,gif,svg,avif}',
  { eager: true, import: 'default' }
);

const paletteList: [string, string, string][] = [
  ['#0b1026', '#243a8f', '#8fb3ff'],
  ['#03131a', '#0b4a52', '#6fe7de'],
  ['#1a1010', '#7a3b2a', '#ffb38f'],
  ['#171126', '#4b2a74', '#c9b6ff'],
  ['#101a12', '#31523a', '#b9e6b0'],
  ['#1b1408', '#6b4a1d', '#f6c56e'],
];
const paletteFor = (key: string): [string, string, string] => {
  let h = 0;
  for (const ch of key) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return paletteList[h % paletteList.length];
};

const resolvePostMeta = (baseSlug: string, ref: string): ImageMetadata | undefined => {
  if (!ref || /^(https?:|\/|data:|#)/.test(ref)) return undefined;
  let clean = ref.replace(/^(\.\/)+/, '');
  try { clean = decodeURIComponent(clean); } catch { /* keep as-is */ }
  return postImageIndex.get(('/src/content/post/' + baseSlug + '/' + clean).toLowerCase());
};

const resolveImage = async (baseSlug: string, url: string) => {
  const meta = resolvePostMeta(baseSlug, url);
  if (!meta) return undefined;
  return {
    src: withBase(meta.src),
    original: withBase(meta.src),
    openLabel: t('content.openImage', lang),
    width: meta.width,
    height: meta.height,
  };
};

const resolveChapterLink = (baseSlug: string, url: string, chapters: Map<string, string>) => {
  let decoded = url;
  try { decoded = decodeURIComponent(url); } catch { /* keep raw */ }
  const suffixMatch = /([?#].*)$/.exec(decoded);
  const suffix = suffixMatch?.[1] ?? '';
  const clean = (suffix ? decoded.slice(0, -suffix.length) : decoded)
    .replaceAll('\\', '/')
    .replaceAll('{lang}', lang);
  if (!/\.md$/i.test(clean)) return undefined;
  let target = posix.normalize(posix.join(baseSlug, clean.replace(/\.md$/i, '')));
  if (target.endsWith('/' + lang)) target = target.slice(0, -(lang.length + 1));
  const anchor = chapters.get(target);
  return anchor ? '#' + anchor + suffix : undefined;
};

const svgData = (svg: string) => 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
const projectCover = (title: string, palette: string[]) => {
  const safe = title.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;' }[c]!));
  return svgData(`<svg xmlns="http://www.w3.org/2000/svg" width="720" height="480" viewBox="0 0 720 480"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${palette[0]}"/><stop offset=".55" stop-color="${palette[1]}"/><stop offset="1" stop-color="${palette[2]}"/></linearGradient></defs><rect width="720" height="480" fill="url(#g)"/><circle cx="560" cy="120" r="160" fill="${palette[2]}" fill-opacity=".22"/><text x="52" y="380" fill="#fff" fill-opacity=".9" font-family="Georgia,serif" font-size="54">${safe}</text></svg>`);
};

const allProjects = await getCollection('projects');
const langProjects = await Promise.all(
  allProjects
    .filter((entry) => !entry.data.draft && entry.id.endsWith('/' + lang))
    .sort((a, b) => a.data.index.localeCompare(b.data.index))
    .map(async (entry) => {
      const slug = entry.id.slice(0, -(lang.length + 1));
      const imagePaths = Object.keys(projectImageModules).filter((path) => path.startsWith('/src/content/projects/' + slug + '/')).sort();
      const coverRef = entry.data.cover?.replace(/^(\.\/)+/, '');
      const image = (coverRef ? projectImageModules['/src/content/projects/' + slug + '/' + coverRef] : undefined)
        ?? projectImageModules[imagePaths[0]];
      const cover = image
        ? (await getImage({ src: image, width: 900, format: 'avif', quality: 90 })).src
        : entry.data.cover && /^(https?:|\/)/.test(entry.data.cover)
          ? (/^https?:/.test(entry.data.cover) ? entry.data.cover : withBase(entry.data.cover))
          : projectCover(entry.data.title, entry.data.palette);
      const coverFile = Object.keys(projectImageModules).find((path) => projectImageModules[path] === image);
      const accent = await coverAccent(coverFile ?? cover);
      const { html } = await renderMarkdown(entry.body ?? '', {
        resolveImage: async (url) => {
          let ref = url;
          try { ref = decodeURIComponent(ref); } catch { /* keep filename */ }
          const meta = projectImageModules['/src/content/projects/' + posix.normalize(posix.join(slug, ref))];
          return meta ? { src: meta.src, original: meta.src, width: meta.width, height: meta.height, openLabel: t('content.openImage', lang) } : undefined;
        },
      });
      return {
        slug,
        sheetKey: 'project:' + slug,
        title: entry.data.title,
        category: entry.data.role,
        year: entry.data.year,
        summary: entry.data.summary,
        tags: entry.data.tags,
        palette: entry.data.palette,
        cover,
        accent,
        html,
      };
    })
);

const allPosts = await getCollection('posts');
const langPosts = allPosts.filter((entry) => entry.id.startsWith(lang + '/'));

const preparedPosts = await Promise.all(
  langPosts
    .filter((entry) => !entry.data.isSubpage && !entry.data.draft)
    .map(async (entry) => {
      const slug = entry.id.slice(lang.length + 1);
      const subpages = langPosts
        .filter((child) => child.data.isSubpage && child.id.startsWith(lang + '/' + slug + '/') && !child.data.draft)
        .sort((a, b) => a.id.localeCompare(b.id));

      const chapters = new Map<string, string>();
      subpages.forEach((child, index) => {
        chapters.set(child.id.slice(lang.length + 1), 'chapter-' + index);
      });

      const mainHtml = await renderMarkdown(entry.body ?? '', {
        resolveImage: (url) => resolveImage(slug, url),
        resolveLink: (url) => resolveChapterLink(slug, url, chapters),
      });

      const renderedChapters = await Promise.all(
        subpages.map(async (child) => {
          const childSlug = child.id.slice(lang.length + 1);
          const result = await renderMarkdown(child.body ?? '', {
            resolveImage: (url) => resolveImage(childSlug, url),
            resolveLink: (url) => resolveChapterLink(childSlug, url, chapters),
          });
          return {
            id: chapters.get(childSlug)!,
            title: child.data.title,
            html: result.html,
          };
        })
      );

      const explicitCover = entry.data.postImage?.trim();
      const firstCover = postFilesBySlug(slug)[0];
      const image = explicitCover && explicitCover !== ' '
        ? resolvePostMeta(slug, explicitCover) ?? (firstCover ? postImageModules[firstCover] : undefined)
        : firstCover
          ? postImageModules[firstCover]
          : undefined;

      const date = entry.data.pubDate
        ? entry.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.')
        : '';

      let thumb: string | undefined;
      if (image) {
        try {
          thumb = (await getImage({ src: image, width: 900, format: 'avif', quality: 90 })).src;
        } catch {
          thumb = undefined;
        }
      }
      const palette = paletteFor(entry.data.category + slug);
      const cover = thumb ?? projectCover(entry.data.title, palette);
      const coverFile = Object.keys(postImageModules).find((path) => postImageModules[path] === image);
      const accent = await coverAccent(coverFile ?? cover);

      return {
        kind: 'post' as const,
        id: 'post-' + slug,
        slug,
        sheetKey: 'post:' + slug,
        title: entry.data.title,
        meta: [entry.data.category, date].filter(Boolean).join(' · '),
        palette,
        cover,
        accent,
        ratio: image ? image.width / image.height : 1.5,
        date,
        homepined: entry.data.homepined,
        pinedOrder: entry.data.pinedOrder,
        image,
        thumb,
        description: entry.data.description ?? '',
        category: entry.data.category,
        tags: entry.data.tag,
        html: mainHtml.html,
        chapters: renderedChapters,
      };
    })
);

const albumEntries = getAlbumEntries(lang);
const albumItems = await Promise.all(
  albumEntries.map(async (entry) => {
    const meta = albumImageModules['/src/content/album/' + entry.file];
    let thumb: string | undefined;
    if (meta) {
      try {
        thumb = (await getImage({ src: meta, width: 900, format: 'avif', quality: 90 })).src;
      } catch {
        thumb = undefined;
      }
    }
    return {
      kind: 'album' as const,
      file: entry.file,
      id: 'album-' + entry.id,
      title: entry.title,
      meta: [entry.date, entry.location].filter(Boolean).join(' · '),
      palette: paletteFor(entry.file),
      ratio: meta ? meta.width / meta.height : (entry.width && entry.height ? entry.width / entry.height : 1.5),
      date: entry.date,
      image: meta,
      thumb,
      imageUrl: entry.src,
      videoUrl: entry.kind === 'video' ? entry.src : undefined,
      mediaType: entry.kind,
    };
  })
);

const portfolioCards = getAlbumHomeItems(lang).filter(
  (item): item is PortfolioCard => 'type' in item && item.type === 'portfolio'
);
const preparedPortfolios = await Promise.all(portfolioCards.map(async (portfolio) => {
  const referenced = new Set<string>();
  const resolveMedia = (url: string) => {
    const asset = resolvePortfolioAsset(portfolio.folder, url);
    if (asset) referenced.add(asset.file);
    return asset;
  };
  const { html } = await renderMarkdown(portfolio.markdown, {
    resolveImage: async (url) => {
      const asset = resolveMedia(url);
      if (!asset || asset.kind === 'video') return undefined;
      const image = albumItems.find((item) => item.file === asset.file);
      return { ...asset, src: image?.thumb ?? asset.src, original: asset.src, openLabel: t('content.openImage', lang) };
    },
    resolveMedia,
    resolveLink: (url) => resolvePortfolioAsset(portfolio.folder, url)?.src,
  });
  const members = albumEntries.filter((entry) => entry.file.startsWith(portfolio.folder + '/'));
  const ordered = [...members.filter((entry) => entry.file === portfolio.coverFile), ...members.filter((entry) => entry.file !== portfolio.coverFile)];
  const media = await Promise.all(ordered.filter((entry) => !referenced.has(entry.file)).map(async (entry) => {
    const { aperture, shutterSpeed, iso, focalLength, exposureCompensation } = entry.exif;
    const lens = /^\d+(?:\.\d+)?[-–]\d+(?:\.\d+)?$/.test(entry.exif.lens)
      ? `${entry.exif.lens.replace('-', '–')}mm` : entry.exif.lens;
    const settings = [
      aperture ? (/^f\//i.test(aperture) ? aperture : `f/${aperture.replace(/^f\/?/i, '')}`) : '',
      shutterSpeed ? (/(?:s|sec)$/i.test(shutterSpeed) ? shutterSpeed : `${shutterSpeed}s`) : '',
      iso ? `ISO${iso.replace(/^iso\s*/i, '')}` : '',
    ].filter(Boolean).join(' · ');
    const optics = [
      focalLength ? (/mm$/i.test(focalLength) ? focalLength : `${focalLength}mm`) : '',
      exposureCompensation ? (/ev$/i.test(exposureCompensation) ? exposureCompensation : `${exposureCompensation} EV`) : '',
    ].filter(Boolean).join(' · ');
    return {
      ...entry,
      thumb: albumItems.find((item) => item.file === entry.file)?.thumb,
      lens,
      settings,
      optics,
      html: entry.text ? (await renderMarkdown(entry.text, { resolveMedia })).html : '',
    };
  }));
  const cover = albumItems.find((item) => item.file === portfolio.coverFile);
  return {
    ...portfolio,
    kind: 'portfolio' as const,
    sheetKey: 'portfolio:' + portfolio.id,
    image: cover?.image,
    thumb: cover?.thumb,
    palette: paletteFor(portfolio.folder),
    ratio: portfolio.width && portfolio.height ? portfolio.width / portfolio.height : 1.5,
    html,
    media,
  };
}));

const items = [...albumItems, ...preparedPortfolios].sort((a, b) => {
  const byDate = b.date.localeCompare(a.date);
  return byDate || a.title.localeCompare(b.title);
});
const orderedPosts = [...preparedPosts].sort((a, b) => {
  if (a.homepined !== b.homepined) return a.homepined ? -1 : 1;
  if (a.homepined) {
    const byPinnedOrder = a.pinedOrder - b.pinedOrder;
    if (byPinnedOrder) return byPinnedOrder;
  }
  return b.date.localeCompare(a.date) || a.title.localeCompare(b.title) || a.slug.localeCompare(b.slug);
});
const grids = [
  {
    id: 'projects',
    label: 'Projects',
    empty: t('content.projects.empty', lang),
    items: langProjects.map((project) => ({
      id: project.slug, title: project.title, image: project.cover, sheetKey: project.sheetKey,
      subtitle: [project.category, project.year].filter(Boolean).join(' · '), accent: project.accent,
    })),
  },
  {
    id: 'posts',
    label: 'Posts',
    empty: t('content.posts.empty', lang),
    items: orderedPosts.map((post) => ({
      id: post.slug, title: post.title, image: post.cover, sheetKey: post.sheetKey,
      subtitle: post.meta, accent: post.accent,
    })),
  },
];
---

<section id="content" class="content-flow" data-section data-content-depth aria-label={lang === 'zh' ? '内容' : lang === 'ja' ? 'コンテンツ' : 'Content'}>
  <div class="content-catalog">
    {grids.map((grid) => (
      <section id={grid.id} class="content-collection" data-content-grid data-expanded="false" aria-labelledby={grid.id + '-title'}>
        <header class="content-collection__header">
          <h2 id={grid.id + '-title'}>{grid.label}</h2>
          <span class="content-collection__count">{String(grid.items.length).padStart(2, '0')}</span>
          <button
            type="button"
            class="content-collection__toggle"
            data-grid-toggle
            data-expand-label={t('content.expand', lang)}
            data-collapse-label={t('content.collapse', lang)}
            data-collection-label={grid.label}
            aria-label={`${t('content.expand', lang)} ${grid.label}`}
            aria-expanded="false"
            aria-controls={grid.id + '-grid'}
            disabled={grid.items.length <= 3}
          >
            <span data-grid-toggle-label>{t('content.expand', lang)}</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
          </button>
        </header>
        <div id={grid.id + '-grid'} class="content-collection__viewport" data-grid-viewport>
          <ChromaGrid client:load items={grid.items} cardRadius={6} columns={3} minCardWidth={230} gap={20} />
        </div>
        {grid.items.length === 0 && <p class="content-collection__empty">{grid.empty}</p>}
      </section>
    ))}
  </div>

  <div class="content-wall">
    {items.map((item, index) => {
      const style = `--r: ${item.ratio.toFixed(4)}; --p1: ${item.palette[0]}; --p2: ${item.palette[1]}; --p3: ${item.palette[2]}; --reveal-delay: ${Math.min(index, 8) * 0.04}s`;
      const cover = item.image ? (
        <img
          src={item.thumb ?? ''}
          alt=""
          width={item.image.width}
          height={item.image.height}
          loading={index < 4 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="content-art" aria-hidden="true"></span>
      );

      return (
        item.kind === 'portfolio' ? (
          <button
            type="button"
            class="content-tile content-tile--portfolio"
            data-content-sheet-trigger={item.sheetKey}
            data-ratio={item.ratio.toFixed(4)}
            style={style}
            aria-label={`${t('content.portfolio', lang)}: ${item.title}`}
            aria-haspopup="dialog"
          >
            {cover}
            <span class="portfolio-badge" data-portfolio-badge>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3" y="6" width="13" height="11" rx="1.5"/><path d="M6 3h10a1 1 0 0 1 1 1v10M8 1h9a2 2 0 0 1 2 2v9"/></svg>
              <span>{t('content.portfolio', lang)} · {item.count}</span>
            </span>
          </button>
        ) : (
        <button
          type="button"
          class:list={['content-tile', 'content-tile--media', { 'content-tile--video': Boolean(item.videoUrl) }]}
          data-media-tile
          data-media-id={item.id}
          data-src={item.imageUrl ?? ''}
          data-video={item.videoUrl ?? ''}
          data-caption={item.title}
          data-meta={item.meta ?? ''}
          data-ratio={item.ratio.toFixed(4)}
          style={style}
          aria-label={item.title}
          aria-haspopup="dialog"
          data-reveal
        >
          {cover}
        </button>
        )
      );
    })}
  </div>
</section>

{langProjects.map((project) => (
  <template data-content-sheet={project.sheetKey}>
    <article class="sheet-article">
      <p class="detail-kicker">
        <span>{project.year}</span>
        <span>{project.category}</span>
        {project.tags.length > 0 && <span>{project.tags.join(' / ')}</span>}
      </p>
      <h1 class="detail-title">{project.title}</h1>
      <p class="detail-summary">{project.summary}</p>
      <div class="detail-hero" style={`--p1: ${project.palette[0]}; --p2: ${project.palette[1]}; --p3: ${project.palette[2]}`}>
        <span class="detail-mark">会</span>
      </div>
      <div class="detail-body" set:html={project.html}></div>
    </article>
  </template>
))}

{orderedPosts.map((post) => (
  <template data-content-sheet={post.sheetKey}>
    <article class="sheet-article">
      <p class="detail-kicker">
        <span>{post.category}</span>
        {post.date && <span>{post.date}</span>}
        {post.tags.length > 0 && <span>{post.tags.join(' / ')}</span>}
      </p>
      <h1 class="detail-title">{post.title}</h1>
      {post.description && <p class="detail-summary">{post.description}</p>}

      {post.thumb && (
        <figure class="sheet-cover">
          <img src={post.thumb} alt="" loading="lazy" decoding="async" />
        </figure>
      )}

      <div class="detail-body" set:html={post.html}></div>

      {post.chapters.map((chapter) => (
        <section class="sheet-chapter" id={chapter.id}>
          <h2>{chapter.title}</h2>
          <div class="detail-body" set:html={chapter.html}></div>
        </section>
      ))}
    </article>
  </template>
))}

{preparedPortfolios.map((portfolio) => (
  <template data-content-sheet={portfolio.sheetKey} data-content-kind="portfolio">
    <article class="sheet-article sheet-portfolio" data-portfolio-content>
      <header class="portfolio-intro" data-fade-content>
        <p class="detail-kicker">
          <span>{t('content.portfolio', lang)}</span>
          {portfolio.category && <span>{portfolio.category}</span>}
          {portfolio.date && <span>{portfolio.date}</span>}
          <span>{portfolio.count} {t('content.mediaCount', lang)}</span>
        </p>
        <h1 class="detail-title">{portfolio.title}</h1>
        {portfolio.description && <p class="detail-summary">{portfolio.description}</p>}
      </header>
      {portfolio.html && <div class="detail-body portfolio-narrative" data-portfolio-narrative set:html={portfolio.html}></div>}
      <div class="portfolio-sequence">
        {portfolio.media.map((media, index) => (
          <section class:list={['portfolio-entry', { 'portfolio-entry--reverse': index % 2 === 1 }]} data-fade-content>
            <div class="portfolio-visual">
              {media.kind === 'video' ? (
                <video src={media.src} controls playsinline preload="metadata" aria-label={media.title || portfolio.title}></video>
              ) : (
                <button type="button" class="portfolio-image" data-media-ref={'album-' + media.id} aria-label={`${t('content.openImage', lang)}: ${media.title}`}>
                  <img src={media.thumb ?? media.src} alt={media.title} width={media.width} height={media.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                </button>
              )}
            </div>
            <aside class="portfolio-info">
              <p class="portfolio-info__index">{String(index + 1).padStart(2, '0')} / {String(portfolio.media.length).padStart(2, '0')}</p>
              <h2>{media.title}</h2>
              {[media.date, media.location, media.photographer, media.category].some(Boolean) && (
                <div class="portfolio-info__facts">
                  {media.date && (
                    <div class="portfolio-info__fact" aria-label={`${t('content.date', lang)}: ${media.date}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
                      <time>{media.date}</time>
                    </div>
                  )}
                  {media.location && (
                    <div class="portfolio-info__fact" aria-label={`${t('content.location', lang)}: ${media.location}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                      <span>{media.location}</span>
                    </div>
                  )}
                  {media.photographer && (
                    <div class="portfolio-info__fact" aria-label={`${t('content.photographer', lang)}: ${media.photographer}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                      <span>by {media.photographer}</span>
                    </div>
                  )}
                  {media.category && (
                    <div class="portfolio-info__fact" aria-label={`${t('content.category', lang)}: ${media.category}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="8" cy="8" r="1.5"/></svg>
                      <span class="portfolio-info__category">{media.category}</span>
                    </div>
                  )}
                </div>
              )}
              {[media.exif.camera, media.exif.lens, media.settings, media.optics].some(Boolean) && (
                <div class="portfolio-info__specs">
                  {media.exif.camera && <p>{media.exif.camera}</p>}
                  {media.lens && <p>{media.lens}</p>}
                  {media.settings && <p>{media.settings}</p>}
                  {media.optics && <p>{media.optics}</p>}
                </div>
              )}
              {(media.description || media.html) && (
                <div class="portfolio-info__copy">
                  {media.description && <p class="portfolio-info__description">{media.description}</p>}
                  {media.html && <div class="detail-body portfolio-text" set:html={media.html}></div>}
                </div>
              )}
            </aside>
          </section>
        ))}
      </div>
    </article>
  </template>
))}

<div class="content-sheet" data-content-sheet-root hidden role="dialog" aria-modal="true" aria-label={t('content.reader', lang)}>
  <div class="content-sheet__bar">
    <button class="content-sheet__close" type="button" data-content-sheet-close aria-label={t('aria.close', lang)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="content-sheet__scroll" data-content-sheet-scroll data-lenis-prevent tabindex="0" role="region" aria-label={t('content.reader', lang)}>
    <div class="content-sheet__inner" data-content-sheet-content></div>
  </div>
</div>

<dialog class="media-viewer" data-media-viewer data-lenis-prevent aria-label="Media viewer" tabindex="-1">
  <div class="media-viewer__stage">
    <div class="media-viewer__media" data-viewer-stage></div>
    <div class="media-viewer__caption">
      <p class="media-viewer__title" data-viewer-title></p>
      <p class="media-viewer__meta" data-viewer-meta></p>
    </div>
  </div>

  <div class="media-viewer__ui">
    <button class="media-viewer__btn" type="button" data-viewer-prev aria-label={t('aria.previous', lang)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <span class="media-viewer__counter">
      <span data-viewer-index>01</span>
      <span class="media-viewer__sep" aria-hidden="true">/</span>
      <span data-viewer-total>00</span>
    </span>
    <button class="media-viewer__btn" type="button" data-viewer-next aria-label={t('aria.next', lang)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <button class="media-viewer__btn media-viewer__close" type="button" data-viewer-close aria-label={t('aria.close', lang)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
</dialog>


<script>
  function initMediaViewer() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-media-viewer]');
    if (!dialog || dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';

    const media = dialog.querySelector<HTMLElement>('[data-viewer-stage]');
    const titleEl = dialog.querySelector<HTMLElement>('[data-viewer-title]');
    const metaEl = dialog.querySelector<HTMLElement>('[data-viewer-meta]');
    const indexEl = dialog.querySelector<HTMLElement>('[data-viewer-index]');
    const totalEl = dialog.querySelector<HTMLElement>('[data-viewer-total]');
    const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-media-tile]'));
    const prev = dialog.querySelector<HTMLButtonElement>('[data-viewer-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]');
    if (!media || !titleEl || !metaEl || !indexEl || !totalEl || !tiles.length) return;
    const controller = new AbortController();
    const { signal } = controller;

    let current = -1;
    totalEl.textContent = String(tiles.length).padStart(2, '0');

    const render = () => {
      const tile = tiles[current];
      if (!tile) return;
      media.replaceChildren();
      const src = tile.dataset.src ?? '';
      const video = tile.dataset.video ?? '';

      if (video) {
        const player = document.createElement('video');
        player.src = video;
        if (src && src !== video) player.poster = src;
        player.controls = true;
        player.autoplay = true;
        player.muted = true;
        player.loop = true;
        player.playsInline = true;
        media.append(player);
      } else if (src) {
        const image = document.createElement('img');
        image.src = src;
        image.alt = '';
        image.decoding = 'async';
        media.append(image);
      } else {
        const fallback = document.createElement('div');
        fallback.className = 'media-viewer__fallback';
        fallback.style.setProperty('--p1', tile.style.getPropertyValue('--p1'));
        fallback.style.setProperty('--p2', tile.style.getPropertyValue('--p2'));
        fallback.style.setProperty('--p3', tile.style.getPropertyValue('--p3'));
        fallback.style.setProperty('--r', tile.dataset.ratio ?? '1.5');
        media.append(fallback);
      }

      titleEl.textContent = tile.dataset.caption ?? '';
      metaEl.textContent = tile.dataset.meta ?? '';
      metaEl.hidden = !metaEl.textContent;
      indexEl.textContent = String(current + 1).padStart(2, '0');
      if (prev) prev.hidden = tiles.length < 2;
      if (next) next.hidden = tiles.length < 2;
    };

    const openAt = (index: number) => {
      current = (index + tiles.length) % tiles.length;
      render();
      dialog.showModal();
      dialog.focus({ preventScroll: true });
      document.documentElement.classList.add('is-media-open');
    };

    const step = (direction: number) => {
      if (!dialog.open) return;
      openAt(current + direction);
    };

    tiles.forEach((tile, index) => {
      tile.addEventListener('click', () => openAt(index));
    });
    document.addEventListener('click', (event) => {
      const image = event.target instanceof Element
        ? event.target.closest<HTMLElement>('[data-media-ref], [data-portfolio-content] [data-post-original]') : null;
      if (!image) return;
      const index = tiles.findIndex((tile) => image.dataset.mediaRef
        ? tile.dataset.mediaId === image.dataset.mediaRef : tile.dataset.src === image.dataset.postOriginal);
      if (index < 0) return;
      event.preventDefault();
      openAt(index);
    }, { signal });
    dialog.querySelectorAll('[data-viewer-close]').forEach((button) => {
      button.addEventListener('click', () => dialog.close());
    });
    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('is-media-open');
      media.replaceChildren();
      current = -1;
    });
    document.addEventListener('keydown', (event) => {
      if (!dialog.open && (event.key === 'Enter' || event.key === ' ')
        && event.target instanceof HTMLElement && event.target.matches('[data-portfolio-content] [data-post-original]')) {
        event.preventDefault();
        event.target.click();
        return;
      }
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    }, { signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal });
  }

  document.addEventListener('astro:page-load', initMediaViewer);
  initMediaViewer();
</script>

<script>
  import { initContentGrids } from '../scripts/contentGrids';

  document.addEventListener('astro:page-load', initContentGrids);
  initContentGrids();
