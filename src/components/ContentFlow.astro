---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { t } from '../i18n';
import { withBase } from '../utils/paths';
import { LANGS, type Lang } from '../types';
import '../styles/content-depth.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const langIndex = LANGS.indexOf(lang);

const imageModules = import.meta.glob<ImageMetadata>('/src/content/**/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});
const videoModules = import.meta.glob<string>('/src/content/**/*.{mp4,webm}', {
  eager: true,
  query: '?url',
  import: 'default',
});

const pickFolderImage = (folder: string) => {
  const entries = Object.entries(imageModules).filter(([path]) => path.includes('/' + folder + '/'));
  const cover = entries.find(([path]) => /\/cover\.[^.]+$/.test(path));
  return (cover ?? entries[0])?.[1];
};

const albumKey = (src: string) => '/src/content/album/' + src.replace(/^\.\//, '');
const ratioFor = (ratio: string) => (ratio === 'portrait' ? 0.75 : ratio === 'square' ? 1 : 1.5);

type FeedItem = {
  kind: 'project' | 'thought' | 'album';
  id: string;
  href: string;
  title: string;
  palette: [string, string, string];
  ratio: number;
  date: string;
  image?: ImageMetadata;
  videoUrl?: string;
};

const projects = (await getCollection('project'))
  .filter((entry) => entry.id.endsWith('/' + lang))
  .map((entry) => {
    const slug = entry.id.split('/')[0];
    const image = pickFolderImage(slug);
    return {
      kind: 'project' as const,
      id: 'project-' + slug,
      href: withBase('/' + lang + '/projects/' + slug + '/'),
      title: entry.data.title,
      palette: entry.data.palette as [string, string, string],
      ratio: image ? image.width / image.height : 1.5,
      date: entry.data.year + '.00.' + entry.data.index,
      image,
    };
  });

const thoughts = (await getCollection('post'))
  .filter((entry) => entry.id.endsWith('/' + lang))
  .map((entry) => {
    const slug = entry.id.split('/')[0];
    const image = pickFolderImage(slug);
    return {
      kind: 'thought' as const,
      id: 'thought-' + slug,
      href: withBase('/' + lang + '/thoughts/' + slug + '/'),
      title: entry.data.title,
      palette: entry.data.palette as [string, string, string],
      ratio: image ? image.width / image.height : 1.5,
      date: entry.data.date,
      image,
    };
  });

const album = (await getCollection('album'))
  .filter((entry) => !entry.data.draft)
  .map((entry) => {
    const image = imageModules[albumKey(entry.data.src)];
    const videoUrl = videoModules[albumKey(entry.data.src)];
    return {
      kind: 'album' as const,
      id: 'album-' + entry.id,
      href: '',
      title: entry.data.title[langIndex] ?? entry.data.title[0],
      palette: (entry.data.palette ?? ['#0b1026', '#22306b', '#8fb3ff']) as [string, string, string],
      ratio: image ? image.width / image.height : ratioFor(entry.data.ratio),
      date: entry.data.date,
      image,
      videoUrl,
    };
  });

const items: FeedItem[] = [...projects, ...thoughts, ...album].sort((a, b) => {
  const byDate = b.date.localeCompare(a.date);
  return byDate || a.title.localeCompare(b.title);
});
---

<section id="content" class="content-flow" data-section data-content-depth aria-label={lang === 'zh' ? '内容' : lang === 'ja' ? 'コンテンツ' : 'Content'}>
  <div class="content-wall">
    {items.map((item, index) => {
      const style = `--r: ${item.ratio.toFixed(4)}; --p1: ${item.palette[0]}; --p2: ${item.palette[1]}; --p3: ${item.palette[2]}; --reveal-delay: ${Math.min(index, 8) * 0.04}s`;
      const media = (
        <>
          {item.image ? (
            <Image
              src={item.image}
              alt=""
              widths={[480, 800, 1200]}
              sizes="(max-width: 700px) 46vw, 30vw"
              loading={index < 4 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <span class="content-art" aria-hidden="true"></span>
          )}
        </>
      );

      if (item.kind === 'album') {
        return (
          <button
            type="button"
            class:list={['content-tile', 'content-tile--media', { 'content-tile--video': Boolean(item.videoUrl) }]}
            data-media-tile
            data-src={item.image?.src ?? ''}
            data-video={item.videoUrl ?? ''}
            data-ratio={item.ratio.toFixed(4)}
            style={style}
            aria-label={item.title}
            aria-haspopup="dialog"
            data-reveal
          >
            {media}
          </button>
        );
      }

      return (
        <a
          class="content-tile content-tile--article"
          href={item.href}
          style={style}
          aria-label={item.title}
          data-reveal
        >
          {media}
        </a>
      );
    })}
  </div>
</section>

<dialog class="media-viewer" data-media-viewer aria-label="Media viewer">
  <button class="media-viewer__close" type="button" data-viewer-close aria-label={t('aria.close', lang)}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="media-viewer__nav media-viewer__prev" type="button" data-viewer-prev aria-label={t('aria.previous', lang)}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <div class="media-viewer__stage" data-viewer-stage></div>
  <button class="media-viewer__nav media-viewer__next" type="button" data-viewer-next aria-label={t('aria.next', lang)}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
</dialog>

<style>
  .content-flow {
    position: relative;
    padding: clamp(3.4rem, 8vh, 6.5rem) 0 clamp(4rem, 9vh, 8rem);
  }
  .content-wall {
    --row: 17rem;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-inline: var(--gutter);
  }
  .content-wall::after {
    content: '';
    flex: 1000000 1 0;
  }
  .content-tile {
    position: relative;
    display: block;
    flex: calc(var(--r) * 1000) 1 calc(var(--r) * var(--row));
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    aspect-ratio: var(--r);
    overflow: hidden;
    border-radius: 8px;
    color: inherit;
    text-align: left;
    background:
      radial-gradient(120% 100% at 28% 18%, var(--p3), transparent 58%),
      linear-gradient(145deg, var(--p2), var(--p1));
    box-shadow: 0 18px 40px -32px rgb(0 0 0 / .55);
    isolation: isolate;
    cursor: pointer;
  }
  .content-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.95) contrast(1.02);
    transition: transform .8s var(--ease-soft), opacity .4s ease;
  }
  .content-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background: linear-gradient(180deg, transparent 62%, rgb(0 0 0 / .16));
    opacity: .55;
    transition: opacity .4s ease;
    pointer-events: none;
  }
  .content-tile--video::before {
    content: '';
    position: absolute;
    z-index: 3;
    left: 14px;
    bottom: 14px;
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 11px solid rgb(255 255 255 / .8);
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / .35));
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .content-tile :global(img) { will-change: transform; }
    .content-tile:hover :global(img) { transform: scale(1.025); }
    .content-tile:hover::after { opacity: .8; }
    .content-wall:has(.content-tile:hover) .content-tile:not(:hover) { opacity: .62; }
    .content-tile { transition: opacity .35s ease; }
  }
  @media (max-width: 700px) {
    .content-wall { --row: 9rem; gap: 8px; }
    .content-tile { border-radius: 6px; }
  }

  .media-viewer {
    width: 100vw;
    max-width: none;
    height: 100svh;
    max-height: none;
    margin: 0;
    padding: clamp(24px, 4vw, 56px);
    border: 0;
    background: transparent;
    color: #fff;
  }
  .media-viewer::backdrop {
    background: rgb(3 5 12 / .86);
    backdrop-filter: blur(16px) saturate(1.1);
  }
  .media-viewer__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .media-viewer__stage :global(img),
  .media-viewer__stage :global(video) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
  }
  :global(.media-viewer__fallback) {
    width: min(86vw, 1200px);
    aspect-ratio: var(--r);
    border-radius: 8px;
    background:
      radial-gradient(120% 100% at 28% 18%, var(--p3), transparent 58%),
      linear-gradient(145deg, var(--p2), var(--p1));
  }
  .media-viewer__close,
  .media-viewer__nav {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / .18);
    border-radius: 50%;
    background: rgb(8 11 18 / .55);
    color: #fff;
    backdrop-filter: blur(10px);
    cursor: pointer;
  }
  .media-viewer__close { top: clamp(16px, 2.4vw, 30px); right: clamp(16px, 2.4vw, 30px); }
  .media-viewer__nav { bottom: clamp(16px, 2.4vw, 30px); }
  .media-viewer__prev { left: clamp(16px, 2.4vw, 30px); }
  .media-viewer__next { right: clamp(16px, 2.4vw, 30px); }
  .media-viewer__close:hover,
  .media-viewer__nav:hover { background: rgb(255 255 255 / .14); }
  .media-viewer__close svg,
  .media-viewer__nav svg { width: 20px; height: 20px; }
  :global(html.is-media-open) { overflow: hidden; }
</style>

<script>
  function initMediaViewer() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-media-viewer]');
    if (!dialog || dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';

    const stage = dialog.querySelector<HTMLElement>('[data-viewer-stage]');
    const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-media-tile]'));
    const prev = dialog.querySelector<HTMLButtonElement>('[data-viewer-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]');
    if (!stage || !tiles.length) return;

    let current = -1;

    const render = () => {
      const tile = tiles[current];
      if (!tile) return;
      stage.replaceChildren();
      const src = tile.dataset.src ?? '';
      const video = tile.dataset.video ?? '';

      if (video) {
        const player = document.createElement('video');
        player.src = video;
        if (src) player.poster = src;
        player.controls = true;
        player.autoplay = true;
        player.muted = true;
        player.loop = true;
        player.playsInline = true;
        stage.append(player);
      } else if (src) {
        const image = document.createElement('img');
        image.src = src;
        image.alt = '';
        image.decoding = 'async';
        stage.append(image);
      } else {
        const fallback = document.createElement('div');
        fallback.className = 'media-viewer__fallback';
        fallback.style.setProperty('--p1', tile.style.getPropertyValue('--p1'));
        fallback.style.setProperty('--p2', tile.style.getPropertyValue('--p2'));
        fallback.style.setProperty('--p3', tile.style.getPropertyValue('--p3'));
        fallback.style.setProperty('--r', tile.dataset.ratio ?? '1.5');
        stage.append(fallback);
      }

      if (prev) prev.hidden = tiles.length < 2;
      if (next) next.hidden = tiles.length < 2;
    };

    const openAt = (index: number) => {
      current = (index + tiles.length) % tiles.length;
      render();
      dialog.showModal();
      document.documentElement.classList.add('is-media-open');
    };

    const step = (direction: number) => {
      if (!dialog.open) return;
      openAt(current + direction);
    };

    tiles.forEach((tile, index) => {
      tile.addEventListener('click', () => openAt(index));
    });
    dialog.querySelectorAll('[data-viewer-close]').forEach((button) => {
      button.addEventListener('click', () => dialog.close());
    });
    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('is-media-open');
      stage.replaceChildren();
      current = -1;
    });
    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });
  }

  document.addEventListener('astro:page-load', initMediaViewer);
  initMediaViewer();
</script>

<script>
  import { initContentDepth } from '../scripts/contentDepth';

  document.addEventListener('astro:page-load', initContentDepth);
  initContentDepth();
</script>
