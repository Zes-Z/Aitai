---
import { siteConfig } from '../../SiteConfig';
import { t } from '../i18n';
import { homePath, withBase } from '../utils/paths';
import type { Lang } from '../types';

interface Props { lang: Lang; home?: boolean }
const { lang, home = true } = Astro.props;
const href = home ? '#drift' : homePath(lang);
---

<a
  class="avatar-dock"
  data-avatar-fixed
  href={href}
  data-home={homePath(lang)}
  data-label-about={t('aria.about', lang)}
  data-label-top={t('aria.scrollTop', lang)}
  aria-label={t('aria.about', lang)}
>
  <img src={withBase(siteConfig.identity.avatar)} alt="" width="120" height="120" />
  <span class="avatar-ring" aria-hidden="true"></span>
</a>

<script>
  import { initAvatarDock } from '../scripts/avatar-dock';
  const run = () => initAvatarDock();
  run();
  document.addEventListener('astro:page-load', run);
</script>
