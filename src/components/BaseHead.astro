---
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../../SiteConfig';
import { withBase } from '../utils/paths';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const siteTitle = `${siteConfig.site.title} · ${siteConfig.site.titleJa}`;
const pageTitle = title ? `${title} · ${siteConfig.site.title}` : siteTitle;
const pageDescription = description || siteConfig.site.description[lang];
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(withBase(siteConfig.identity.avatar), Astro.site ?? Astro.url);
const langs = siteConfig.site.langs;
const defaultTheme = siteConfig.theme.default;

const alternates = langs.map((l) => {
  const path = Astro.url.pathname.replace(new RegExp(`/${lang}(/|$)`), `/${l}$1`);
  return { lang: l, href: new URL(path, Astro.site ?? Astro.url).toString() };
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="alternate" hreflang="x-default" href={new URL(withBase('/zh/'), Astro.site ?? Astro.url).toString()} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.site.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content={defaultTheme === 'dawn' ? '#f7f0e8' : defaultTheme === 'sea' ? '#031018' : '#05060f'} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<script is:inline define:vars={{ defaultTheme }}>
  (() => {
    try {
      const stored = localStorage.getItem('aitai-theme');
      const theme = ['star', 'sea', 'dawn'].includes(stored || '') ? stored : defaultTheme;
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme === 'dawn' ? 'light' : 'dark';
    } catch {
      document.documentElement.dataset.theme = defaultTheme;
    }
    document.documentElement.classList.add('js');
  })();
</script>

<ClientRouter />
