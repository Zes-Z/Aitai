---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../SiteConfig';
import { t } from '../i18n';
import { withBase } from '../utils/paths';
import { skills } from '../data/sample';
import type { Lang } from '../types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cv = siteConfig.identity.socials.find((social) => social.icon === 'cv');
const resume = cv?.href ? withBase(cv.href) : undefined;
const status = siteConfig.identity.status[lang];
const location = siteConfig.identity.location[lang];
const timezone = siteConfig.identity.timezone;
const doubledSkills = [...skills, ...skills];

const posts = await getCollection('post');
const projects = await getCollection('project');
const album = await getCollection('album');
const countFor = (entries: Array<{ id: string }>) => entries.filter((entry) => entry.id.endsWith('/' + lang)).length;
const photoCount = album.filter((entry) => !entry.data.draft).length;

const stats = [
  { value: siteConfig.site.langs.length, label: { zh: '语言', en: 'Languages', ja: '言語' } },
  { value: countFor(posts), label: { zh: '随想', en: 'Notes', ja: '随想' } },
  { value: photoCount, label: { zh: '照片', en: 'Photos', ja: '写真' } },
  { value: countFor(projects), label: { zh: '项目', en: 'Projects', ja: 'プロジェクト' } },
];
---

<section id="drift" class="section driftage" data-section aria-labelledby="drift-title">
  <div class="section-inner">
    <header class="section-head drift-head" data-reveal>
      <div class="eyebrow">{t('drift.eyebrow', lang)}</div>
      <div>
        <h2 id="drift-title" class="section-title">{t('drift.title', lang)}</h2>
        <p class="section-intro">{t('drift.intro', lang)}</p>
      </div>
    </header>

    <div class="drift-stage" data-drift-stage>
      <div class="drift-grid" aria-hidden="true"></div>

      <div class="drift-stage-meta">
        <span class="mono">{t('drift.drag', lang)} · DRIFT</span>
        <button class="drift-reset" type="button" data-drift-reset>{t('drift.reset', lang)}</button>
      </div>

      <article class="drift-card drift-portrait" data-drift-card style="--x:5;--y:8;--rot:-3deg" data-cursor-label="KIM">
        <div class="drift-portrait-cap">
          <span class="mono">AITAI / 2026</span>
          <strong>KIM</strong>
          <span>{siteConfig.site.tagline[lang]}</span>
        </div>
      </article>

      <article class="drift-card drift-now" data-drift-card style="--x:47;--y:10;--rot:2deg">
        <div class="drift-kicker">{t('drift.nowTitle', lang)}</div>
        <h3>{status}</h3>
        <p>{t('drift.nowBody', lang)}</p>
        <div class="drift-now-meta">
          <span data-clock data-tz={timezone}>--:--</span>
          <span>{location}</span>
        </div>
      </article>

      <article class="drift-card drift-numbers" data-drift-card style="--x:66;--y:53;--rot:-2deg">
        <div class="drift-kicker">NUMBERS</div>
        <div class="drift-stat-grid">
          {stats.map((stat) => (
            <div>
              <b data-count={stat.value}>{stat.value}</b>
              <span>{stat.label[lang]}</span>
            </div>
          ))}
        </div>
      </article>

      {resume && <a
        class="drift-card drift-cv"
        data-drift-card
        style="--x:38;--y:66;--rot:4deg"
        href={resume}
        download
        data-cursor-label="PDF"
      >
        <span class="drift-kicker">CV</span>
        <strong>{t('drift.cv', lang)}</strong>
        <span class="drift-arrow" aria-hidden="true">↗</span>
      </a>}

    </div>

    <div class="drift-skills" data-reveal>
      <span class="drift-skills-label mono">SKILLS</span>
      <div class="drift-skills-track">
        <div class="skills-track">
          {doubledSkills.map((skill) => <span>{skill}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
