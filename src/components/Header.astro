---
import { siteConfig } from '../../SiteConfig';
import { t, l10n } from '../i18n';
import { homePath, withBase } from '../utils/paths';
import LangSwitch from './LangSwitch.astro';
import ThemeOrb from './ThemeOrb.astro';
import type { Lang } from '../types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const home = homePath(lang);
const sections = siteConfig.nav.sections;
---

<header class="site-header" data-header>
  <div class="header-bg" aria-hidden="true"></div>
  <div class="header-inner">
    <div class="header-left">
      <span class="header-avatar-slot" data-avatar-header aria-hidden="true"></span>
      <a class="wordmark" href={home} aria-label="AITAI" data-transition="veil">
        AITAI <span class="jp">会いたい</span>
      </a>
      <nav class="header-nav" aria-label="Sections">
        {sections.map((section) => (
          <a href={`${home}#${section.id}`} data-nav-link>{l10n(section.label, lang)}</a>
        ))}
        <a href={withBase(`/${lang}/projects/`)} data-transition="tide">{t('nav.projects', lang)}</a>
        <a href={withBase(`/${lang}/album/`)} data-transition="develop">{t('nav.album', lang)}</a>
        <a href={withBase(`/${lang}/thoughts/`)} data-transition="constellate">{t('nav.thoughts', lang)}</a>
      </nav>
    </div>

    <div class="header-right">
      <LangSwitch lang={lang} />
      <ThemeOrb lang={lang} />
      <button class="icon-btn menu-button" data-menu-button aria-expanded="false" aria-controls="mobile-menu" aria-label={t('aria.menu', lang)}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>
