    <>
      <rect x="2.2" y="4.8" width="19.6" height="14.4" rx="3.4" fill="#448be3" />
      <path d="m4.2 7.1 7.8 5.8 7.8-5.8" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </>
  ) : name === 'cv' ? (
    <>
      <path d="M6.6 3.2h7.2L18.6 8v12.8H6.6V3.2Z" fill="#d64545" />
      <path d="M13.8 3.2V8h4.8" stroke="#fff" stroke-width="1.4" />
      <path d="M9.4 12.2h5.2m-5.2 3.2H13" stroke="#fff" stroke-width="1.4" stroke-linecap="round" />
    </>
  ) : (
    <>
      <path d="M7 18.5h10a4.5 4.5 0 0 0 .5-9A5.8 5.8 0 0 0 6.3 8.2 5.2 5.2 0 0 0 7 18.5Z" fill="#8d8ad8" />
      <path d="m8.4 13 3.6 2.3 3.6-2.3M12 9.8v5.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
