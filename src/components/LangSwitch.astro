---
import { siteConfig } from '../../SiteConfig';
import { t } from '../i18n';
import { homePath } from '../utils/paths';
import type { Lang } from '../types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const langs = siteConfig.site.langs;
const short: Record<Lang, string> = { zh: '中', en: 'EN', ja: '日' };
---

<nav class="lang-switch" aria-label={t('lang.switch', lang)}>
  {langs.map((l) => (
    <a
      href={homePath(l)}
      hreflang={l}
      lang={l}
      aria-current={l === lang ? 'true' : undefined}
      data-transition="veil"
    >{short[l]}</a>
  ))}
</nav>
